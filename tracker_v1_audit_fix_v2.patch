+delta_radius_random_walk_variance = 1.0
+delta_z_random_walk_variance = 1.0
+
+[radius]
+min_radius_m = 0.05
+max_radius_m = 0.5
+
+[radius_profile]
+balance_2 = 0.2
+outpost_3 = 0.2765
